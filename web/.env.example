NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_ANON_KEY=
NUXT_PUBLIC_EMAIL_DOMAIN=lga.local

# Server-only R2 credentials, needed on hosts without a Cloudflare binding (e.g. Vercel).
# Leave unset for local development (the local R2 emulator is used).
# NUXT_R2_ACCOUNT_ID=
# NUXT_R2_ACCESS_KEY_ID=
# NUXT_R2_SECRET_ACCESS_KEY=
# NUXT_R2_BUCKET=lga-recordings
